# Salin file ini menjadi ".env" lalu isi dengan kredensial Neon kamu.
DB_HOST=ep-xxxx-pooler.region.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASS=isi_password_di_sini
DB_SSLMODE=require
# Endpoint ID Neon = bagian awal host tanpa "-pooler" (contoh: ep-xxxx)
DB_ENDPOINT=ep-xxxx
